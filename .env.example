# KRX AI Trading Assistant v7 SERVERLESS FREE
FREE_MODE=true

# Optional personal settings (keep in GitHub Secrets for public repos)
EXISTING_POSITIONS_JSON=[]
DAY_TRADE_CAPITAL_KRW=5000000

# Korea Investment Open API
KIS_APP_KEY=YOUR_KIS_APP_KEY
KIS_APP_SECRET=YOUR_KIS_APP_SECRET

# OpenDART
DART_API_KEY=YOUR_OPENDART_API_KEY

# Telegram alerts
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Optional free FRED key. Blank = public current-vintage CSV fallback.
FRED_API_KEY=

# Supabase (required for GitHub Actions serverless mode)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the backend-only sb_secret_... key (or legacy service_role key).
# Never put this key in the mobile PWA or source control.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_STATE_BUCKET=krx-ai-state
SUPABASE_PUBLIC_BUCKET=krx-ai-public

# Optional local PC/PWA server mode remains supported.
APP_API_TOKEN=
APP_HOST=0.0.0.0
APP_PORT=8080
