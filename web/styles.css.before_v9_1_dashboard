.market-switch{display:flex;gap:8px;padding:6px;margin-bottom:12px}.market-btn{flex:1;border:0;border-radius:12px;padding:10px 12px;font-weight:800;background:#eef2f7;color:#5b6472}.market-btn.active{background:#0b1730;color:white}.macro-card{padding:15px}.macro-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.macro-item{background:#f5f7fb;border-radius:12px;padding:10px}.macro-item span{display:block;font-size:11px;color:#7b8494}.macro-item b{display:block;margin-top:4px;font-size:14px}.risk-gauge{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.risk-score{font-size:24px;font-weight:900;color:#1565c0}.market-label{font-size:12px;color:#788293;margin-top:3px}.usd .live-price,.usd .level b{font-variant-numeric:tabular-nums}

/* v7.7 market pulse + candidate diagnostics */
.health-badge{font-size:11px;font-weight:850;padding:6px 9px;border-radius:999px;background:rgba(145,164,190,.13);color:#c5d1df;border:1px solid rgba(145,164,190,.2)}
.health-badge.ok{background:rgba(54,211,153,.12);color:#82e6bd;border-color:rgba(54,211,153,.25)}
.health-badge.warn{background:rgba(255,199,102,.12);color:#ffd98f;border-color:rgba(255,199,102,.26)}
.pulse-summary{padding:15px}.pulse-top{display:flex;align-items:center;justify-content:space-between;gap:12px}.pulse-top b{font-size:16px}.pulse-score{min-width:54px;height:54px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:17px;background:rgba(145,164,190,.12);border:3px solid rgba(145,164,190,.25)}.pulse-score.good{color:var(--green);border-color:rgba(54,211,153,.34)}.pulse-score.bad{color:var(--red);border-color:rgba(255,107,122,.34)}.pulse-score.neutral{color:var(--amber);border-color:rgba(255,199,102,.3)}
.pulse-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}.pulse-metrics>div{background:rgba(4,12,24,.42);border-radius:12px;padding:10px}.pulse-metrics span{display:block;color:var(--muted);font-size:10px}.pulse-metrics b{display:block;margin-top:4px;font-size:14px}
.chart-grid{display:grid;grid-template-columns:1fr;gap:10px;margin-top:10px}.index-card{padding:14px}.index-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.index-head>b,.index-head b{font-size:15px}.index-source{font-size:10px;color:var(--muted);margin-top:3px}.index-last{text-align:right;font-size:18px;font-weight:900}.index-last span{display:block;font-size:11px;margin-top:3px}.spark{width:100%;height:92px;margin-top:10px;display:block}.spark-up{color:var(--green)}.spark-down{color:var(--red)}.spark-base{stroke:rgba(145,164,190,.16);stroke-width:1}.chart-empty{height:92px;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:12px}.index-foot{display:flex;justify-content:space-between;gap:8px;margin-top:5px;color:var(--muted);font-size:10px}.index-foot b{font-size:11px}
.health-strip{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px;margin-top:8px}.health-item{padding:8px 5px;text-align:center;border-radius:10px;background:rgba(145,164,190,.08);border:1px solid rgba(145,164,190,.12)}.health-item span{display:block;font-size:9px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.health-item b{display:block;font-size:10px;margin-top:3px}.health-item.ok b{color:var(--green)}.health-item.warn b{color:var(--amber)}.health-item.idle b{color:var(--muted)}
.no-rec{border-color:rgba(255,199,102,.22)}.diagnostics-card{padding:14px}.diag-head{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}.diag-status{font-size:10px;padding:5px 8px;border-radius:999px;background:rgba(255,199,102,.12);color:var(--amber);font-weight:800}.diag-status.ok{background:rgba(54,211,153,.12);color:var(--green)}.diag-list{margin-top:10px}.diag-row{display:grid;grid-template-columns:24px 1fr auto;gap:9px;align-items:start;padding:12px 0;border-top:1px solid rgba(255,255,255,.065)}.diag-rank{width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(91,140,255,.14);color:#bed0ff;font-size:11px;font-weight:900}.diag-main b{font-size:13px}.diag-reasons{display:flex;flex-wrap:wrap;gap:4px;margin-top:5px}.diag-reasons span{font-size:9px;padding:4px 6px;border-radius:8px;background:rgba(255,199,102,.08);color:#f2cf8c;border:1px solid rgba(255,199,102,.12)}.diag-extra{font-size:10px;color:var(--muted);margin-top:5px}.diag-score{text-align:right;min-width:47px}.diag-score strong{display:block;font-size:16px}.diag-score small{display:block;font-size:10px;margin-top:2px}
@media(min-width:620px){.chart-grid{grid-template-columns:1fr 1fr}.health-strip{gap:8px}}

/* v7.8 secure manual refresh */
.top-actions{display:flex;align-items:center;gap:8px}.refresh-btn{width:38px;height:38px;border-radius:50%;border:1px solid var(--line);background:#0b1728;color:var(--cyan);font-size:22px;line-height:1;font-weight:800;display:flex;align-items:center;justify-content:center;box-shadow:none}.refresh-btn:active{transform:scale(.96)}.refresh-btn.busy{animation:refreshSpin 1s linear infinite;opacity:.75}.refresh-btn:disabled{cursor:wait}.refresh-note{margin-top:8px;padding:10px 12px;border-radius:12px;background:rgba(84,210,255,.08);border:1px solid rgba(84,210,255,.14);font-size:11px;color:#b9ddec}@keyframes refreshSpin{to{transform:rotate(360deg)}}
@media(max-width:420px){.live-pill{padding:7px 9px}.refresh-btn{width:36px;height:36px}.topbar{padding-left:15px;padding-right:15px}.topbar h1{font-size:21px}}

/* v8.0 dual-horizon strategy lanes */
.strategy-note{display:flex;gap:10px;align-items:flex-start;padding:13px 15px;border-color:rgba(84,210,255,.18);background:linear-gradient(135deg,rgba(28,67,97,.35),rgba(12,25,42,.97))}.strategy-note b{white-space:nowrap;color:#bfeeff;font-size:12px}.strategy-note span{font-size:11px;color:#b8c7d9;line-height:1.55}.lane-grid{display:grid;grid-template-columns:1fr;gap:16px;margin-top:12px}.lane-panel{min-width:0}.lane-head{display:flex;align-items:flex-end;justify-content:space-between;gap:10px;margin:2px 3px 8px}.lane-head h3{margin:2px 0 0;font-size:15px}.lane-kicker{font-size:9px;letter-spacing:1.2px;color:var(--cyan);font-weight:900}.lane-count{font-size:10px;padding:5px 8px;border-radius:999px;background:rgba(91,140,255,.12);color:#c8d7ff;border:1px solid rgba(91,140,255,.18)}.lane-stack{display:grid;gap:10px}.lane-card{padding:14px}.lane-card.swing{border-color:rgba(153,116,255,.2)}.lane-card-top{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.lane-price{font-size:18px;font-weight:850;margin-top:6px}.lane-price .change{font-size:11px;margin-left:4px}.lane-badge{font-size:10px;font-weight:900;border-radius:999px;padding:6px 8px;border:1px solid transparent}.lane-badge.action{color:#77e6b8;background:rgba(54,211,153,.10);border-color:rgba(54,211,153,.22)}.lane-badge.watch{color:#ffd889;background:rgba(255,199,102,.10);border-color:rgba(255,199,102,.22)}.lane-scoreline{display:flex;align-items:baseline;justify-content:space-between;margin:11px 0 9px;padding-top:9px;border-top:1px solid rgba(255,255,255,.06)}.lane-scoreline>strong{font-size:24px}.lane-scoreline>span{font-size:10px;color:var(--muted)}.lane-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}.lane-metrics>div{padding:8px 6px;border-radius:10px;background:rgba(4,12,24,.43);min-width:0}.lane-metrics span{display:block;color:var(--muted);font-size:9px;white-space:nowrap}.lane-metrics b{display:block;font-size:11px;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.strength-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:10px}.strength-tags span{font-size:9px;color:#c8d8ec;background:rgba(91,140,255,.09);border:1px solid rgba(91,140,255,.15);padding:4px 6px;border-radius:8px}.lane-reasons{margin:9px 0 0;padding-left:17px;color:#f0cc87;font-size:10px;line-height:1.5}.lane-warning{margin-top:9px;font-size:9px;color:var(--muted);line-height:1.45}.lane-empty{padding:15px;min-height:96px}.institution-chip{margin-top:9px;padding:7px 9px;border-radius:10px;background:rgba(153,116,255,.09);border:1px solid rgba(153,116,255,.16);font-size:9px;color:#d6c7ff}.institutional-card{padding:14px}.institution-list{display:grid;gap:0}.institution-row{padding:12px 0;border-bottom:1px solid rgba(255,255,255,.06)}.institution-row:last-child{border-bottom:0}.institution-row>b,.institution-row b{font-size:13px}.institution-changes{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}.institution-changes span{font-size:9px;padding:4px 6px;border-radius:8px;background:rgba(145,164,190,.08);color:#bdcada}.institution-changes span.up{color:#8ae7c1;background:rgba(54,211,153,.08)}.institution-changes span.down{color:#ffadb5;background:rgba(255,107,122,.08)}
@media(min-width:700px){.lane-grid{grid-template-columns:1fr 1fr}.lane-metrics{grid-template-columns:repeat(2,1fr)}}
@media(max-width:390px){.lane-metrics{grid-template-columns:repeat(2,1fr)}.strategy-note{display:block}.strategy-note b{display:block;margin-bottom:5px}}
