:root{--bg:#07111f;--surface:#0d1a2b;--surface2:#11223a;--line:#1e3554;--text:#f4f8ff;--muted:#91a4be;--blue:#5b8cff;--cyan:#54d2ff;--green:#36d399;--red:#ff6b7a;--amber:#ffc766;--shadow:0 18px 45px rgba(0,0,0,.28)}
